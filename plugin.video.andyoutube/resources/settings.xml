<?xml version="1.0" encoding="UTF-8"?>
<settings version="1">
  <section id="plugin.video.andyoutube">
    <category id="general" label="常规">
      <setting id="language" type="string" label="YouTube 语言" default="zh-CN"/>
      <setting id="region" type="string" label="YouTube 地区（两位代码）" default="SG"/>
      <setting id="playback_backend" type="string" label="播放后端" default="auto">
        <constraints>
          <options>
            <option label="自动：优先 yt-dlp，失败回退官方 YouTube">auto</option>
            <option label="仅 yt-dlp">ytdlp</option>
            <option label="仅官方 YouTube 插件播放">official</option>
          </options>
        </constraints>
        <control type="spinner" format="string"/>
      </setting>
    </category>
  </section>
</settings>
